# =============================================================================
# Surfing Online ISP — Environment variables
# =============================================================================
# DOKPLOY: paste these into your service's "Environment" tab.
# LOCAL:   nothing is needed — docker-compose.local.yml has demo defaults.
# =============================================================================

# Your real public address, WITH https. Used for SEO links, canonical URLs and
# the sitemap. It is baked in at build time, so redeploy after changing it.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# First admin login (created once, on first start).
# If you leave ADMIN_PASSWORD empty, a random password is generated and printed
# once in the container logs (Dokploy -> your service -> Logs).
ADMIN_EMAIL=admin@surfingonline.bd
ADMIN_PASSWORD=choose-a-strong-password

# Optional. Signs login cookies. If empty, a random secret is generated once and
# stored in the data volume, so logins still survive restarts and redeploys.
# SESSION_SECRET=

# Keep false on a real site. true creates 3 demo customers (password: customer123).
SEED_DEMO_DATA=false
